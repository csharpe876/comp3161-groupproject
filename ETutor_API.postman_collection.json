{
  "info": {
    "_postman_id": "c3161api-0001-4000-a000-000000000001",
    "name": "ETutor API — COMP3161",
    "description": "Complete API collection for the ETutor course management system.\n\n**Setup:**\n1. Run \"Login as Admin\", \"Login as Lecturer\", and \"Login as Student\" — the test scripts auto-capture the JWT tokens into collection variables.\n2. Use the {{token}} variable (set to whichever role you last logged in as) or manually set {{adminToken}}, {{lecturerToken}}, {{studentToken}}.\n3. Update {{courseId}}, {{forumId}}, {{threadId}}, etc. with real IDs returned from the GET endpoints.\n\n**Test Accounts:**\n| UserID | Password | Role |\n|---|---|---|\n| test_admin | password123 | Admin |\n| test_lecturer | password123 | Lecturer |\n| test_student | password123 | Student |",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost",   "type": "string" },
    { "key": "token",        "value": "",                   "type": "string", "description": "Active JWT — auto-set by login requests" },
    { "key": "adminToken",   "value": "",                   "type": "string" },
    { "key": "lecturerToken","value": "",                   "type": "string" },
    { "key": "studentToken", "value": "",                   "type": "string" },
    { "key": "courseId",     "value": "C1",                 "type": "string", "description": "Seeded course IDs: C1–C200" },
    { "key": "newCourseId",  "value": "CNEW001",            "type": "string" },
    { "key": "forumId",      "value": "1",                  "type": "string", "description": "Set after creating/listing forums" },
    { "key": "threadId",     "value": "1",                  "type": "string" },
    { "key": "replyId",      "value": "1",                  "type": "string" },
    { "key": "assignmentId", "value": "1",                  "type": "string" },
    { "key": "submissionId", "value": "1",                  "type": "string" },
    { "key": "sectionId",    "value": "1",                  "type": "string" },
    { "key": "studentId",    "value": "test_student",       "type": "string" },
    { "key": "lecturerId",   "value": "test_lecturer",      "type": "string" }
  ],

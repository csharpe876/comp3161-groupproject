    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register (Student)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userid\": \"new_student_01\",\n  \"password\": \"password123\",\n  \"name\": \"New Student\",\n  \"email\": \"new.student01@uwi.edu\",\n  \"account_type\": \"Student\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new Student account. account_type must be Student, Lecturer, or Admin (Admin requires an existing Admin JWT)."
          }
        },
        {
          "name": "Register (Lecturer)",
          "request": {

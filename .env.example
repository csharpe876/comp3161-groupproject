# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL connection string (used by backend)
DATABASE_URL=postgresql://courseuser:coursepassword@db:5432/coursedb

# Flask JWT secret — change this to a long random string in production
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Set to "development" to enable debug mode and verbose logs
FLASK_ENV=production

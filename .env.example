# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# These are used by both docker-compose (to create the DB) and the backend.
POSTGRES_DB=comp3161_project
POSTGRES_USER=project_user
POSTGRES_PASSWORD=change_me_strong_password

# Full connection string — overrides the individual vars above for the backend.
# When running via docker-compose this is auto-constructed; set it for local dev.
DATABASE_URL=postgresql://project_user:change_me_strong_password@localhost:5433/comp3161_project

# ── Flask / JWT ────────────────────────────────────────────────────────────────
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-at-least-48-chars

# "development" enables debug mode and verbose logs; use "production" in prod.
FLASK_ENV=production

